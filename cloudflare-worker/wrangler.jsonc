{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "davines-shop-bot",
  "main": "worker.js",
  "compatibility_date": "2026-11-25",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  },
  "vars": {
    "MANAGER_CHAT_ID": "414194396",
    "WEBAPP_URL": "https://ivansergeevich23.github.io/davines-shop/webapp/"
  }
}
